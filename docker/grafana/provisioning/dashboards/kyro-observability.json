{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (RPS by Service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 Latency by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{application}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HikariCP Connection Pool (Active / Idle / Pending)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application) (hikaricp_connections_active)",
          "legendFormat": "{{application}} - active",
          "refId": "A"
        },
        {
          "expr": "sum by (application) (hikaricp_connections_idle)",
          "legendFormat": "{{application}} - idle",
          "refId": "B"
        },
        {
          "expr": "sum by (application) (hikaricp_connections_pending)",
          "legendFormat": "{{application}} - pending",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "RabbitMQ Queue Depth & Dead Letter Queues (.dlq)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue!~\"amq\\\\..*\"} + rabbitmq_queue_messages_unacked{queue!~\"amq\\\\..*\"}",
          "legendFormat": "Queue: {{queue}}",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_queue_messages{queue=~\"^.*\\\\.dlq$\"}",
          "legendFormat": "DLQ: {{queue}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Heap Memory Used by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Garbage Collection Pause Time (s/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum[1m]))",
          "legendFormat": "{{application}} GC",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["kyro", "microservices", "saga", "observability"],
  "templating": {
    "list": []
  },
